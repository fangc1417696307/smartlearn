# 复制本文件为 .env 并填写真实值（.env 不入库）
SECRET_KEY=请改成一段随机字符串
# 数据大屏使用的 Redis（缓存 + 在线统计），默认使用项目自带的 6380 实例
REDIS_URL=redis://127.0.0.1:6380/0
# Kafka 地址（由 scripts/start-kafka.bat 启动）
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=1417696307@qq.com
SMTP_AUTH_CODE=你的QQ邮箱SMTP授权码
ADMIN_INITIAL_PASSWORD=admin123
